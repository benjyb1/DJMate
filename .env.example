# ── Your Supabase Project ──────────────────────────────────────
# Find these at: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here

# ── LLM API Keys (only needed if running the backend locally) ─
# The shared backend already has these configured.
# At least one is required if you're self-hosting the backend.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# ── Optional ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
DB_POOL_SIZE=10
CACHE_TTL=3600
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
